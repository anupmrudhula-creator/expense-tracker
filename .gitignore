node_modules/
dist/

# OS and editor files
.DS_Store
.vscode/
.idea/

# Local tool settings
.claude/

# Local env files (Firebase keys will go here later, never commit secrets)
.env
.env.*
!.env.example

# Firebase CLI cache (created by firebase deploy; not source code)
.firebase/
